{
  "name": "rwc2027-prediction-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:compat": "tsc6 --noEmit && tsc6 -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run typecheck:compat && npm run lint && npm test && vite build",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:cloudflare": "npm run db:migrate:local && wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787 --show-interactive-dev-session=false",
    "db:migrate:local": "wrangler d1 migrations apply SHARES --local",
    "db:migrate:remote": "wrangler d1 migrations apply SHARES --remote",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-solid": "0.18.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
