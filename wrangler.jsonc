{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rwc2027-prediction-tracker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "rwc2027.myplaceforthings.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/",
      "!/assets/*",
      "!/flags/*",
      "!/rwc2027.svg"
    ]
  }
}
